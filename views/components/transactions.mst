{{#HasUnprocessedTransactions}}
<h2>Unprocessed transactions</h2>
<table>
  <thead>
    <tr>
      <th>Date</th>
      <th>Amount</th>
      <th>Description</th>
      <th>Balance</th>
    </tr>
  </thead>
  <tbody>
    {{#UnprocessedTransactions}}
    <tr>
      <td>{{Date}}</td>
      <td>{{Amount}}</td>
      <td>{{Description}}</td>
      <td>{{Balance}}</td>
    </tr>
    {{/UnprocessedTransactions}}
  </tbody>
</table>
{{/HasUnprocessedTransactions}}
