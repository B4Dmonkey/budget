<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://unpkg.com/htmx.org@2.0.2"></script>
  <script src="//unpkg.com/alpinejs" defer></script>
  <title>WTG</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <main id="app">
    <h1>Whats the gap?</h1>
    <h2>Budget</h2>
    <div x-data="{ open: false }">
      <button @click="open=true">Edit</button>
      <form x-show="open">
        <label for="amount">Amount:</label>
        <input type="number" id="amount" name="amount" value="{{Budget}}">
        <button @click="open=false">Save</button>
      </form>
    </div>
    <h2>Add document</h2>
    <form hx-post="/documents" enctype="multipart/form-data" hx-target="#transactions">
      <label for="file">Upload File:</label>
      <input type="file" id="file" name="file">
      <button type="submit">Upload</button>
    </form>
    <section id="transactions" >
    
    </section>
    {{#HasUnprocessedTransactions}}
    <h2>Unprocessed transactions</h2>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Amount</th>
          <th>Description</th>
          <th>Balance</th>
        </tr>
      </thead>
      <tbody>
        {{#UnprocessedTransactions}}
          <tr>
            <td>{{Date}}</td>
            <td>{{Amount}}</td>
            <td>{{Description}}</td>
            <td>{{Balance}}</td>
          </tr>
        {{/UnprocessedTransactions}}
      </tbody>
    {{/HasUnprocessedTransactions}}
  </main>
</body>
</html>